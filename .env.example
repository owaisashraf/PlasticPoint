# Port the app listens on. The UI opens at http://localhost:PORT
PORT=3000

# Leave empty to use the "allow LAN access" setting (127.0.0.1 or 0.0.0.0).
# Set only to force a specific address.
HOST=

# Folder for the database, backups, invoices and logs. Relative paths are
# resolved from the app folder.
DATA_DIR=./data

# Secret used to sign session cookies. Leave empty and ShopLedger creates one
# in DATA_DIR/secret.key, so it moves together with the data folder.
SESSION_SECRET=
